PROJECT_NAME="DocuMind AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="documind-super-secret-dev-key-change-in-production-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql+psycopg://documind:documind_pw@localhost:5432/documind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Vector Search & Embedding Configuration
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE_DOCUMENT="RETRIEVAL_DOCUMENT"
EMBEDDING_TASK_TYPE_QUERY="RETRIEVAL_QUERY"
EMBEDDING_NORMALIZE=true
MAX_EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.0

# Text Chunking Configuration
CHUNK_SIZE_TOKENS=1500
CHUNK_OVERLAP_TOKENS=200

# Semantic Search & RAG Retrieval Configuration
SEMANTIC_SEARCH_DEFAULT_LIMIT=10
SEMANTIC_SEARCH_MAX_LIMIT=50
SEMANTIC_SEARCH_MIN_SIMILARITY=0.5
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
MAX_QUERY_LENGTH_CHARS=4000

# Gemini Chat Generation Configuration
GEMINI_CHAT_MODEL="gemini-1.5-flash"
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
CHAT_HISTORY_TOKEN_BUDGET=2000
CHAT_DEFAULT_TOP_K=5

# Vector Indexing Strategy
VECTOR_INDEX_TYPE="hnsw"
VECTOR_DISTANCE_STRATEGY="cosine"
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# Document Storage & Upload Limits
DOCUMENT_STORAGE_DIR="./storage/documents"
MAX_FILE_SIZE_BYTES=20971520
