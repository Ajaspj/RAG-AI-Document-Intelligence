PROJECT_NAME="DocuMind AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="documind-super-secret-dev-key-change-in-production-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql+psycopg://documind:documind_pw@localhost:5432/documind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Gemini Vector Search & Embedding Configuration
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE_DOCUMENT="RETRIEVAL_DOCUMENT"
EMBEDDING_TASK_TYPE_QUERY="RETRIEVAL_QUERY"
EMBEDDING_NORMALIZE=true

# Vector Indexing Strategy
VECTOR_INDEX_TYPE="hnsw"
VECTOR_DISTANCE_STRATEGY="cosine"
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# Document Storage & Upload Limits
DOCUMENT_STORAGE_DIR="./storage/documents"
MAX_FILE_SIZE_BYTES=20971520
